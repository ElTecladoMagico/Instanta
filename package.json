{
  "name": "instanta",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently -n next,convex -c blue,magenta \"npm run dev\" \"npx convex dev\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "uv run -q --python 3.13 --with-requirements db/requirements.txt alembic -c db/alembic.ini upgrade head",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:db": "uv run -q --python 3.13 --with-requirements db/requirements-dev.txt pytest -q db/tests",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"lib/**\" --test-coverage-include=\"src/app/v1/**\" \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@clerk/nextjs": "^6.35.1",
    "@tanstack/react-query": "^5.90.9",
    "canvas-confetti": "^1.9.4",
    "convex": "^1.29.1",
    "lucide-react": "^0.554.0",
    "next": "16.0.3",
    "postgres": "^3.4.9",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "viem": "^2.39.0",
    "wagmi": "^2.19.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.0.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
