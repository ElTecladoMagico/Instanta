# TLS automático (Let's Encrypt) para el dominio de DOMAIN. Sin logs de acceso:
# las URLs del checkout llevan el client_secret (ADR-010).
{$DOMAIN} {
	encode zstd gzip
	redir /demo /demo/
	# Tienda de ejemplo (ADR-012): /demo/… va a su contenedor, sin el prefijo.
	handle_path /demo/* {
		reverse_proxy demo-store:4000
	}
	handle {
		reverse_proxy app:3000
	}
}
