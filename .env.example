# ==============================================================================
# Instanta — Environment Variables
# ==============================================================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
# ==============================================================================

# Convex — Serverless backend and real-time database
# Get your deployment URL from: https://dashboard.convex.dev
NEXT_PUBLIC_CONVEX_URL=

# Clerk — Authentication
# Get your keys from: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Alchemy — Blockchain RPC provider (Base Sepolia)
# Get your API key from: https://dashboard.alchemy.com
# Optional: falls back to public Base Sepolia RPC if not set
NEXT_PUBLIC_ALCHEMY_RPC_URL=

# App URL — Used to generate embeddable button snippets
# Set this to your production URL (e.g., https://instanta.vercel.app)
# Optional: falls back to window.location.origin in the browser
NEXT_PUBLIC_APP_URL=
